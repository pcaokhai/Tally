{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tally.example/events/subscription.schema.json",
  "title": "Subscription events",
  "description": "Envelope + data. Kafka key = tenant_id. Headers: event-type, tenant-id, traceparent, schema-version (docs/04 \u00a77).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "api_version",
    "tenant_id",
    "created_at",
    "livemode",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9]{8,40}$"
    },
    "type": {
      "enum": [
        "subscription.created",
        "subscription.renewed",
        "subscription.updated",
        "subscription.canceled",
        "subscription.trial_ending"
      ]
    },
    "api_version": {
      "const": "2026-09-01"
    },
    "tenant_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "livemode": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "required": [
        "subscription_id",
        "customer_id",
        "status"
      ],
      "properties": {
        "subscription_id": {
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "TRIALING",
            "ACTIVE",
            "PAST_DUE",
            "CANCELED"
          ]
        },
        "current_period_end": {
          "type": "string",
          "format": "date-time"
        },
        "cancel_at_period_end": {
          "type": "boolean"
        },
        "mrr": {
          "$ref": "#/$defs/Money"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "Money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[a-z]{3}$"
        }
      }
    }
  }
}
