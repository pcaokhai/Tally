{
  "realm": "tally-operators",
  "displayName": "Tally operators",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      {"name": "operator-readonly", "description": "Read-only console access"},
      {"name": "operator-support", "description": "Support actions, impersonation with approval"},
      {"name": "operator-approver", "description": "Second pair of eyes for approvals"},
      {"name": "operator-admin", "description": "Platform configuration"}
    ]
  },
  "clients": [
    {
      "clientId": "ops-web",
      "name": "Operator console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3100/*"],
      "webOrigins": ["http://localhost:3100"],
      "attributes": {"pkce.code.challenge.method": "S256"}
    },
    {
      "clientId": "tally-core-ops",
      "name": "Core operator API resource server",
      "enabled": true,
      "bearerOnly": true
    }
  ]
}
